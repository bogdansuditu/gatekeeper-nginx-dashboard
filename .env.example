# ========================================================
# Gatekeeper Dashboard Environment Configuration
# ========================================================

# Server & Networking
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Host Data Storage (Where SQLite database, cached favicons, and avatars are stored on your host)
DATA_DIR=./dashboard-data

# Container Internal Storage Paths (Do not change unless customizing internal Docker layout)
DATABASE_PATH=/data/gatekeeper.sqlite
CACHE_DIR=/data/cache

# Security & Encryption Secret
# IMPORTANT: Used for session tokens and AES-256 encryption of stored credentials in SQLite.
# Keep this secret constant once set to preserve access to encrypted settings.
JWT_SECRET=change_this_to_a_random_secure_secret_key_in_production

# Initial Admin Credentials (Provisioned on first startup if no users exist in database)
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=adminpassword

# Demo Data Fallback (Serves sample homelab applications if NPM is not yet configured)
ENABLE_DEMO_DATA=true

# Homelab SSL Verification (false = accept self-signed certificates for internal services)
STRICT_SSL=false

# Optional Default Upstream Nginx Proxy Manager (NPM) Settings
# (Leave empty if you prefer to configure NPM credentials via the UI Settings modal)
NPM_DEFAULT_HOST=
NPM_DEFAULT_USER=
NPM_DEFAULT_PASS=
NPM_TIMEOUT_MS=15000

# Background Monitoring & Synchronization Intervals
SYNC_INTERVAL_MINUTES=5
HEALTHCHECK_INTERVAL_SECONDS=60
