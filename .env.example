# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
DATABASE_PATH=/data/gatekeeper.sqlite
CACHE_DIR=/data/cache
JWT_SECRET=change_this_to_a_random_secure_secret_key_in_production

# Initial Admin Credentials (Provisioned on first startup if no users exist)
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=adminpassword

# Demo Data (Generates realistic sample homelab hosts matching the dashboard design when NPM is not configured)
ENABLE_DEMO_DATA=true

# Homelab SSL Verification (false = ignore self-signed certificate errors for local hosts)
STRICT_SSL=false

# Optional Upstream Nginx Proxy Manager (NPM) Settings
NPM_DEFAULT_HOST=http://nginx-proxy-manager:81
NPM_DEFAULT_USER=admin@example.com
NPM_DEFAULT_PASS=changeme
SYNC_INTERVAL_MINUTES=5
HEALTHCHECK_INTERVAL_SECONDS=60
